{
  "name": "trailpack",
  "version": "0.6.1",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:nps-integrity": "tsx scripts/check-nps-source-integrity.ts",
    "refresh:nps-sources": "tsx scripts/check-nps-source-integrity.ts --apply",
    "scenario:stress": "node scripts/generate-hiker-scenario-report.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:a11y": "playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "next": "^15.5.24",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.5.24",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
